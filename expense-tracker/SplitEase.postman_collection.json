            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/groups/{{group_id}}/members", "host": ["{{base_url}}"], "path": ["api","groups","{{group_id}}","members"] }
          }
