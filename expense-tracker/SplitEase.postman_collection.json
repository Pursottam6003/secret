              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Conflict on duplicate', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/groups/{{group_id}}/members?email=bob@demo.com",
              "host": ["{{base_url}}"],
              "path": ["api","groups","{{group_id}}","members"],
              "query": [{ "key": "email", "value": "bob@demo.com" }]
            }
          }
        },

        {
