{
  "info": {
    "name": "SplitEase — Expense Tracker API",
    "_postman_id": "splitease-v1-collection",
    "description": "Complete API collection for SplitEase.\n\n**How to use:**\n1. Import this collection AND the `SplitEase.postman_environment.json` file.\n2. Select the `SplitEase Local` environment.\n3. Run the requests **in order** — each request auto-saves IDs into environment variables.\n4. Start with the Auth folder to get your JWT token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    }
  ],
  "variable": [
    { "key": "base_url",      "value": "http://localhost:8080" },
    { "key": "access_token",  "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "alice_id",      "value": "" },
    { "key": "bob_id",        "value": "" },
    { "key": "carol_id",      "value": "" },
    { "key": "group_id",      "value": "" },
    { "key": "expense_id_1",  "value": "" },
    { "key": "expense_id_2",  "value": "" },
    { "key": "expense_id_3",  "value": "" },
    { "key": "settlement_id", "value": "" }
  ],
  "item": [

    {
      "name": "01 - Auth",
      "description": "Register three demo users, log in as Alice, and test token refresh.",
      "item": [

        {
          "name": "Register Alice (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) {",
                  "    pm.collectionVariables.set('access_token',  json.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', json.refreshToken);",
                  "    pm.collectionVariables.set('alice_id',      json.userId);",
                  "    pm.test('Alice registered', () => pm.response.to.have.status(200));",
                  "    console.log('Alice ID:', json.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Johnson\",\n  \"email\": \"alice@demo.com\",\n  \"password\": \"password123\",\n  \"phone\": \"+1 555 100 0001\"\n}"
            }
          }
        },

        {
          "name": "Register Bob",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.userId) {",
                  "    pm.collectionVariables.set('bob_id', json.userId);",
                  "    pm.test('Bob registered', () => pm.response.to.have.status(200));",
                  "    console.log('Bob ID:', json.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Smith\",\n  \"email\": \"bob@demo.com\",\n  \"password\": \"password123\",\n  \"phone\": \"+1 555 100 0002\"\n}"
            }
          }
        },

        {
          "name": "Register Carol",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.userId) {",
                  "    pm.collectionVariables.set('carol_id', json.userId);",
                  "    pm.test('Carol registered', () => pm.response.to.have.status(200));",
                  "    console.log('Carol ID:', json.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carol White\",\n  \"email\": \"carol@demo.com\",\n  \"password\": \"password123\",\n  \"phone\": \"+1 555 100 0003\"\n}"
            }
          }
        },

        {
          "name": "Login as Alice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Login successful', () => pm.response.to.have.status(200));",
                  "pm.test('Has access token', () => pm.expect(json.accessToken).to.be.a('string'));",
                  "pm.collectionVariables.set('access_token',  json.accessToken);",
                  "pm.collectionVariables.set('refresh_token', json.refreshToken);",
                  "pm.collectionVariables.set('alice_id',      json.userId);",
                  "console.log('Logged in as Alice. Token saved.');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@demo.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },

        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Token refreshed', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('access_token',  json.accessToken);",
                  "pm.collectionVariables.set('refresh_token', json.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/refresh?refreshToken={{refresh_token}}",
              "host": ["{{base_url}}"],
              "path": ["api","auth","refresh"],
              "query": [{ "key": "refreshToken", "value": "{{refresh_token}}" }]
            }
          }
        },

        {
          "name": "Login — Wrong Password (should 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 401 for bad creds', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@demo.com\",\n  \"password\": \"WRONG_PASSWORD\"\n}"
            }
          }
        }

      ]
    },

    {
      "name": "02 - Groups",
      "description": "Create groups, manage members, list and delete groups.",
      "item": [

        {
          "name": "Create Group — Vegas Trip",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Group created', () => pm.response.to.have.status(200));",
                  "pm.test('Group has ID', () => pm.expect(json.id).to.be.a('number'));",
                  "pm.collectionVariables.set('group_id', json.id);",
                  "console.log('Group ID:', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/groups", "host": ["{{base_url}}"], "path": ["api","groups"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vegas Road Trip\",\n  \"description\": \"Splitting costs for our July Vegas trip\",\n  \"defaultCurrency\": \"USD\",\n  \"memberEmails\": [\"bob@demo.com\", \"carol@demo.com\"]\n}"
            }
          }
        },

        {
          "name": "Get My Groups",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
